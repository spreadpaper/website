---
import '../styles/style.css'

/** One step on the trail from the homepage to this page. */
export interface Crumb {
  name: string
  /** Site absolute, with a leading slash. `/` is the homepage. */
  path: string
}

export interface Props {
  title: string
  description: string
  /** Social card copy, which sells rather than describes and so differs from `description`. */
  socialDescription: string
  /**
   * The trail to this page, homepage first. Given, it adds a BreadcrumbList to
   * the graph; omitted, the graph is the shared one and nothing changes, which
   * is why the homepage passes nothing.
   */
  breadcrumb?: Crumb[]
}

const { title, description, socialDescription, breadcrumb } = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL('/og-image.jpg', Astro.site).href
const imageAlt =
  'Two monitors on a desk showing one photograph of a lake and mountains carried across both screens'

/**
 * Appended to the graph only where a page supplies a trail, so the four shared
 * nodes below stay byte for byte what they were on every page.
 */
const breadcrumbNode = breadcrumb?.length
  ? [
      {
        '@type': 'BreadcrumbList',
        '@id': `${canonical}#breadcrumb`,
        itemListElement: breadcrumb.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.name,
          // The trailing slash is added rather than trusted to the author: Astro
          // builds to directories, so `canonical` is always `/help/`, and a crumb
          // pointing at `/help` would name a second URL for the same page.
          item: new URL(crumb.path.endsWith('/') ? crumb.path : `${crumb.path}/`, Astro.site).href,
        })),
      },
    ]
  : []

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    ...breadcrumbNode,
    {
      '@type': 'WebSite',
      '@id': 'https://spreadpaper.app/#website',
      url: 'https://spreadpaper.app/',
      name: 'SpreadPaper',
      description:
        'Free, open source macOS app that spreads one photograph across every connected display.',
      inLanguage: 'en',
      publisher: { '@id': 'https://github.com/spreadpaper#organization' },
    },
    {
      '@type': 'Organization',
      '@id': 'https://github.com/spreadpaper#organization',
      name: 'SpreadPaper',
      url: 'https://github.com/spreadpaper',
    },
    {
      '@type': 'Person',
      '@id': 'https://spreadpaper.app/#author',
      name: 'Robin van Baalen',
      url: 'https://robinvanbaalen.nl',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://spreadpaper.app/#app',
      name: 'SpreadPaper',
      url: 'https://spreadpaper.app/',
      description:
        'SpreadPaper is a native macOS app that uses one high-resolution photograph as the wallpaper for every connected monitor at once. It renders a separate file per display, compensates for the bezels between them, and saves each arrangement as a reusable preset. A wallpaper can be one still image, a Light and Dark pair that follows the system appearance, or up to 16 images on a time-of-day schedule.',
      applicationCategory: 'DesktopEnhancementApplication',
      applicationSubCategory: 'Wallpaper',
      operatingSystem: 'macOS 15.0 Sequoia or later',
      processorRequirements: 'Apple Silicon',
      softwareRequirements: 'macOS 15.0 Sequoia or later on an Apple Silicon Mac',
      isAccessibleForFree: true,
      license: 'https://github.com/spreadpaper/SpreadPaper/blob/main/LICENSE',
      downloadUrl: 'https://github.com/spreadpaper/SpreadPaper/releases/latest',
      installUrl: 'https://github.com/spreadpaper/SpreadPaper/releases/latest',
      codeRepository: 'https://github.com/spreadpaper/SpreadPaper',
      image: 'https://spreadpaper.app/og-image.jpg',
      screenshot:
        'https://raw.githubusercontent.com/spreadpaper/SpreadPaper/main/.github/assets/main-app-screenshot.png',
      sameAs: ['https://github.com/spreadpaper/SpreadPaper'],
      author: { '@id': 'https://spreadpaper.app/#author' },
      publisher: { '@id': 'https://github.com/spreadpaper#organization' },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
      featureList: [
        'One photograph spread across two, three or more monitors',
        'A Light and Dark image pair that follows the macOS appearance',
        'Up to 16 images on a time-of-day schedule, in step on every screen',
        'Bezel compensation, set per monitor or once for all of them',
        'Drag, zoom, fit and flip the image on a canvas that mirrors the display arrangement',
        'Preview the wallpaper on the real screens before saving',
        'Reusable presets with search, filtering, renaming and duplication',
      ],
    },
  ],
}
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#16161a" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content="SpreadPaper" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preload" as="image" href="/photos/hero-beach.jpg" fetchpriority="high" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main.ts'
    </script>
  </body>
</html>
