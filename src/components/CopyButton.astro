---
import Icon from './Icon.astro'

/**
 * Copies a string to the clipboard and says so.
 *
 * The two faces are stacked in one grid cell, so the button is as wide as its
 * widest label and never resizes mid animation. On success they roll upward:
 * the old face leaves through the top, the new one arrives from the bottom,
 * which reads as one state replacing another rather than two things blinking.
 *
 * It ships hidden and unhides itself, because a copy button is a lie without a
 * clipboard. The text it copies is a prop rather than a DOM lookup, so the
 * button cannot end up pointing at an element that has moved or been renamed.
 */
export interface Props {
  /** The exact string written to the clipboard. */
  value: string
  label?: string
  copiedLabel?: string
  /** Named in the screen reader announcement, for example "the command". */
  describes?: string
}

const { value, label = 'Copy', copiedLabel = 'Copied', describes } = Astro.props
---

<button class="copy" type="button" hidden data-copy={value} aria-live="polite">
  <span class="copy-faces">
    <span class="copy-face" data-face="idle">
      <Icon name="copy" class="copy-glyph" />
      {label}
    </span>
    <span class="copy-face" data-face="done" aria-hidden="true">
      <Icon name="check" class="copy-glyph" />
      {copiedLabel}
    </span>
  </span>
  {describes && <span class="sr-only"> {describes}</span>}
</button>

<style>
  .copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid var(--color-cd-border-strong);
    border-radius: 999px;
    background-color: var(--color-cd-bg-elevated);
    color: var(--color-cd-text);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    overflow: hidden;
    transition:
      transform 120ms var(--ease-out),
      border-color 180ms ease-out,
      background-color 180ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .copy:hover {
      background-color: var(--color-cd-bg-hover);
    }
  }

  /* The press is the only feedback available before the clipboard answers, so
     it happens on pointerdown rather than waiting for the write to resolve. */
  .copy:active {
    transform: scale(0.97);
  }

  .copy:focus-visible {
    outline: 2px solid var(--color-cd-accent);
    outline-offset: 2px;
  }

  .copy[data-copied] {
    border-color: color-mix(in srgb, var(--color-cd-success) 45%, transparent);
    background-color: color-mix(in srgb, var(--color-cd-success) 12%, transparent);
  }

  /* One cell, two faces: the column is as wide as "Copied" whichever is
     showing, so the button holds its size and the roll has nothing to fight. */
  .copy-faces {
    display: grid;
    place-items: center;
  }

  .copy-face {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    white-space: nowrap;
    transition:
      transform 260ms var(--ease-out),
      opacity 180ms var(--ease-out);
  }

  .copy-face[data-face='done'] {
    transform: translateY(110%);
    opacity: 0;
    color: var(--color-cd-success);
  }

  .copy[data-copied] .copy-face[data-face='idle'] {
    transform: translateY(-110%);
    opacity: 0;
  }

  .copy[data-copied] .copy-face[data-face='done'] {
    transform: translateY(0);
    opacity: 1;
  }

  .copy-glyph {
    width: 0.875rem;
    height: 0.875rem;
  }

  /* The roll is spatial, so it goes; the fade stays, because the confirmation
     still has to be legible as a change. */
  @media (prefers-reduced-motion: reduce) {
    .copy,
    .copy-face {
      transition-property: opacity, background-color, border-color;
    }

    .copy-face {
      transform: none !important;
    }
  }
</style>

<script>
  /**
   * Wires every copy button on the page. The confirmation clears itself after
   * a beat, and a repeat press restarts that beat rather than stacking timers.
   */
  function setupCopyButtons() {
    if (!navigator.clipboard) return

    document.querySelectorAll<HTMLButtonElement>('.copy[data-copy]').forEach((button) => {
      button.hidden = false

      const idle = button.querySelector('[data-face="idle"]')
      const done = button.querySelector('[data-face="done"]')
      let clear: ReturnType<typeof setTimeout> | undefined

      const show = (copied: boolean) => {
        button.toggleAttribute('data-copied', copied)
        // Only the visible face is announced, so the button never reads twice.
        idle?.toggleAttribute('aria-hidden', copied)
        done?.toggleAttribute('aria-hidden', !copied)
      }

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy!)
        } catch {
          return
        }

        show(true)
        clearTimeout(clear)
        clear = setTimeout(() => show(false), 2000)
      })
    })
  }

  setupCopyButtons()
</script>
