---
import Bezels from '../components/sections/Bezels.astro'
import Download from '../components/sections/Download.astro'
import Editor from '../components/sections/Editor.astro'
import Footer from '../components/sections/Footer.astro'
import Gallery from '../components/sections/Gallery.astro'
import Hero from '../components/sections/Hero.astro'
import Nav from '../components/sections/Nav.astro'
import Types from '../components/sections/Types.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Span one wallpaper across multiple monitors on a Mac | SpreadPaper"
  description="Free, open source macOS app that spreads one wallpaper across two, three or more monitors. Bezel compensation, Light and Dark pairs, time-of-day schedules."
  socialDescription="One wallpaper across two, three or more monitors, lined up across the bezels. Free, open source, native macOS."
>
  <Nav />
  <main id="main">
    <Hero />
    <Types />
    <Editor />
    <Bezels />
    <Gallery />
    <Download />
  </main>
  <Footer />
</Layout>
