---
import Footer from '../components/sections/Footer.astro'
import Nav from '../components/sections/Nav.astro'
import Layout from '../layouts/Layout.astro'

/** One destination on this site, with the words someone might search it by. */
type Destination = {
  name: string
  path: string
  what: string
  /** Terms a visitor is likely to type that should find this page. */
  words: string
}

const destinations: Destination[] = [
  {
    name: 'The app itself',
    path: '/',
    what: 'What SpreadPaper does, and the download',
    words: 'home download app spread wallpaper monitors displays mac front page',
  },
  {
    name: 'Help',
    path: '/help',
    what: 'Getting past the first launch warning, and what else goes wrong',
    words: 'install open warning gatekeeper unsigned damaged malware first launch troubleshooting support',
  },
  {
    name: 'Guides',
    path: '/guides',
    what: 'Spanning two monitors, and how bezel compensation works',
    words: 'bezel compensation span two monitors gap seam tutorial how to step by step',
  },
  {
    name: 'About',
    path: '/about',
    what: 'Who builds it and everyone who has shaped it',
    words: 'who robin contributors open source credits curacao project team',
  },
  {
    name: 'Alternatives',
    path: '/alternatives',
    what: 'Which other apps genuinely span a wallpaper',
    words: 'superpaper spanright multiscape fresco compare comparison free paid competitors',
  },
  {
    name: 'Privacy Policy',
    path: '/privacy',
    what: 'The one request the app makes',
    words: 'data tracking analytics telemetry request github update check gdpr cookies',
  },
  {
    name: 'Terms of Service',
    path: '/terms',
    what: 'The MIT licence, in short',
    words: 'licence license mit warranty fork name legal terms conditions',
  },
]
---

<Layout
  title="Page not found | SpreadPaper"
  description="Jump to any page on spreadpaper.app. SpreadPaper spreads one photograph across every Mac display."
  socialDescription="One photograph across two, three or more monitors, lined up across the bezels. Free, open source, native macOS."
>
  <Nav />
  <main id="main" class="bg-cd-bg">
    <div class="nf">
      <p class="cd-eyebrow">404</p>
      <h1 class="nf-title">Jump to any page</h1>
      <p class="nf-lead">
        <span class="nf-asked" id="nf-asked">That address</span> has nothing on it. Every page on this
        site is below.
      </p>

      <div class="nf-field" id="nf-field" hidden>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.6" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M10.6 10.6 L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
          ></path>
        </svg>
        <input
          id="nf-input"
          type="search"
          placeholder="Search seven pages"
          autocomplete="off"
          aria-label="Filter the pages on this site"
          aria-describedby="nf-count"
        />
        <span class="nf-count" id="nf-count">{destinations.length}</span>
      </div>
      <p class="sr-only" id="nf-status" role="status"></p>

      <div class="nf-rows" id="nf-rows">
        {
          destinations.map((page) => (
            <div
              class="nf-slot"
              data-hay={`${page.name} ${page.what} ${page.path} ${page.words}`.toLowerCase()}
            >
              <div class="nf-clip">
                <a class="nf-row" href={page.path}>
                  <span>
                    <b class="nf-name" data-text={page.name}>
                      {page.name}
                    </b>
                    <span class="nf-what" data-text={page.what}>
                      {page.what}
                    </span>
                  </span>
                  <span class="nf-path">{page.path}</span>
                </a>
              </div>
            </div>
          ))
        }
        <p class="nf-empty" id="nf-empty" hidden>
          Nothing matches that. <a href="/">The front page</a> has the app and the download.
        </p>
      </div>

      <p class="nf-keys" id="nf-keys" hidden>
        <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> move</span>
        <span><kbd>&crarr;</kbd> open</span>
        <span><kbd>esc</kbd> clear</span>
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  /**
   * Turns the static list of destinations into a filter. Every row is rendered
   * at build time, so the page works without this; the script narrows the list,
   * marks the matched text and adds arrow key navigation.
   */
  function setupNotFound() {
    const field = document.getElementById('nf-field')
    const input = document.getElementById('nf-input') as HTMLInputElement | null
    const count = document.getElementById('nf-count')
    const status = document.getElementById('nf-status')
    const empty = document.getElementById('nf-empty')
    const rows = document.getElementById('nf-rows')
    const keys = document.getElementById('nf-keys')
    const asked = document.getElementById('nf-asked')
    if (!field || !input || !count || !status || !empty || !rows || !keys) return

    const slots = [...document.querySelectorAll<HTMLElement>('.nf-slot')]
    if (slots.length === 0) return

    field.hidden = false
    keys.hidden = false
    if (asked) asked.textContent = location.pathname

    /** Rewrites one cell, wrapping the first match so the reader can see why it matched. */
    function paint(cell: HTMLElement, term: string) {
      const text = cell.dataset.text ?? ''
      const at = term ? text.toLowerCase().indexOf(term) : -1
      if (at < 0) {
        cell.textContent = text
        return
      }
      cell.textContent = ''
      cell.append(text.slice(0, at))
      const hit = document.createElement('mark')
      hit.textContent = text.slice(at, at + term.length)
      cell.append(hit, text.slice(at + term.length))
    }

    function visible() {
      return slots.filter((slot) => !slot.hasAttribute('data-off'))
    }

    function draw() {
      const term = input!.value.trim().toLowerCase()
      slots.forEach((slot) => {
        const off = term !== '' && !(slot.dataset.hay ?? '').includes(term)
        slot.toggleAttribute('data-off', off)
        // A filtered row keeps its box so the track can collapse, so it is made
        // inert instead: it stays out of the tab order and out of the reading.
        slot.toggleAttribute('inert', off)
        slot.querySelectorAll<HTMLElement>('[data-text]').forEach((cell) => paint(cell, term))
      })
      const shown = visible().length
      count!.textContent = String(shown)
      empty!.hidden = shown > 0
      status!.textContent = shown === 0 ? 'Nothing matches' : shown === 1 ? '1 page matches' : `${shown} pages match`
    }

    /** Every link still on offer, in the order they are read. */
    function links() {
      return visible()
        .map((slot) => slot.querySelector<HTMLAnchorElement>('.nf-row'))
        .filter((row): row is HTMLAnchorElement => row !== null)
    }

    /* The arrows move the focus itself rather than painting a marker on the
       row. A marker is a picture of a selection and is announced to nobody,
       and a focused link already carries its name, its ring and its Enter. */
    function moveFocus(step: number) {
      const row = links()
      if (row.length === 0) return
      const here = row.indexOf(document.activeElement as HTMLAnchorElement)
      const next = here < 0 ? (step > 0 ? 0 : row.length - 1) : (here + step + row.length) % row.length
      row[next].focus()
      row[next].scrollIntoView({ block: 'nearest' })
    }

    input.addEventListener('input', draw)
    input.addEventListener('search', draw)
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        // A search input clears itself on Escape without firing `input`, so the
        // filter is reset here and a second press leaves the field.
        if (input.value !== '') {
          input.value = ''
          draw()
        } else {
          input.blur()
        }
      } else if (event.key === 'ArrowDown') {
        event.preventDefault()
        moveFocus(1)
      } else if (event.key === 'ArrowUp') {
        event.preventDefault()
        moveFocus(-1)
      } else if (event.key === 'Enter') {
        const target = links()[0]
        if (target) {
          event.preventDefault()
          location.assign(target.href)
        }
      }
    })

    // The arrows keep working once the focus has left the field for the list,
    // and Escape hands it back rather than stranding the reader in the rows.
    rows.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault()
        moveFocus(1)
      } else if (event.key === 'ArrowUp') {
        event.preventDefault()
        moveFocus(-1)
      } else if (event.key === 'Escape') {
        input!.focus()
      }
    })

    draw()
  }

  setupNotFound()
</script>

<style>
  .nf {
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: 1.5rem;
    padding-block: 5rem;
  }

  .nf-title {
    margin: 1rem 0 0;
    max-width: 22ch;
    font-size: clamp(1.875rem, 4.6vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.06;
    text-wrap: balance;
    color: var(--color-cd-text);
  }

  .nf-lead {
    margin: 1rem 0 0;
    max-width: 48ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-cd-text-secondary);
  }

  .nf-asked {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-cd-text);
    overflow-wrap: anywhere;
  }

  .nf-field {
    display: flex;
    align-items: center;
    gap: 0.6875rem;
    max-width: 40rem;
    margin-top: 1.75rem;
    padding-block: 0.8125rem;
    padding-inline: 1rem;
    border: 1px solid var(--color-cd-border-strong);
    border-radius: 12px;
    background: var(--color-cd-bg-secondary);
    color: var(--color-cd-text-tertiary);
    transition: border-color 160ms var(--ease-out);
  }

  .nf-field:focus-within {
    border-color: var(--color-cd-accent);
  }

  .nf-field svg {
    flex: none;
  }

  .nf-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-cd-text);
    font-family: inherit;
    font-size: 1rem;
    outline: none;
  }

  .nf-field input::placeholder {
    color: var(--color-cd-text-tertiary);
  }

  .nf-count {
    flex: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }

  .nf-rows {
    max-width: 40rem;
    margin-top: 0.625rem;
    border: 1px solid var(--color-cd-border);
    border-radius: 12px;
    overflow: hidden;
  }

  /* A filtered row collapses its own track rather than being hidden, since
     display: none cannot transition. The row clips inside it. */
  .nf-slot {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 200ms var(--ease-out),
      opacity 140ms var(--ease-out);
  }

  .nf-slot[data-off] {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  /* Padding lives on the row, inside the clipper. A grid item stretched to a
     zero track still renders its own padding, so the clipper carries none. */
  .nf-clip {
    min-height: 0;
    overflow: hidden;
  }

  .nf-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    padding-block: 0.8125rem;
    padding-inline: 1rem;
    background: var(--color-cd-bg-secondary);
    text-decoration: none;
    border-top: 1px solid var(--color-cd-border);
    transition:
      background-color 140ms var(--ease-out),
      transform 140ms var(--ease-out);
  }

  .nf-slot:first-child .nf-row {
    border-top: 0;
  }

  .nf-row:hover,
  .nf-row:focus-visible {
    background: var(--color-cd-bg-elevated);
  }

  .nf-row:focus-visible {
    outline: 2px solid var(--color-cd-accent);
    outline-offset: -2px;
  }

  .nf-row:active {
    transform: scale(0.985);
  }

  .nf-name {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-cd-text);
  }

  .nf-what {
    display: block;
    margin-top: 0.1875rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-cd-text-tertiary);
  }

  .nf-row :global(mark) {
    background: color-mix(in srgb, var(--color-cd-accent) 32%, transparent);
    color: #fff;
    border-radius: 2px;
  }

  .nf-path {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--color-cd-text-tertiary);
  }

  .nf-empty {
    margin: 0;
    padding-block: 1.125rem;
    padding-inline: 1rem;
    background: var(--color-cd-bg-secondary);
    font-size: 0.875rem;
    color: var(--color-cd-text-secondary);
  }

  .nf-empty a {
    color: var(--color-cd-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nf-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 1.125rem;
    margin: 0.875rem 0 0;
    font-size: 0.6875rem;
    color: var(--color-cd-text-tertiary);
  }

  .nf-keys kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.625rem;
    padding-block: 0.125rem;
    padding-inline: 0.3125rem;
    margin-right: 0.3125rem;
    border: 1px solid var(--color-cd-border-strong);
    border-radius: 4px;
    color: var(--color-cd-text-secondary);
  }

  @media (max-width: 40rem) {
    .nf-row {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-slot {
      transition: none;
    }

    .nf-row {
      transition: background-color 140ms var(--ease-out);
    }
  }
</style>
